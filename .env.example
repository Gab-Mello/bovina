# Local Compose only. Copy to the ignored .env and choose three distinct local passwords.
# Explicitly opt into the local OAuth overlay; base Compose has no dev-auth service.
COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Password for PostgreSQL's initial bootstrap user (not used by the API).
POSTGRES_PASSWORD=
# Password for the Flyway migration role.
BOVINA_MIGRATION_PASSWORD=
# Password for the restricted application runtime role.
BOVINA_RUNTIME_PASSWORD=
# The token issuer is the URL used by the host-side dev-token helper.
BOVINA_SECURITY_ISSUER=http://localhost:8090/default
# The API container fetches public signing keys over the Compose network.
BOVINA_SECURITY_JWK_SET_URI=http://dev-auth:8080/default/jwks
# Required JWT audience for this API.
BOVINA_SECURITY_AUDIENCE=bovina
# Local-only bootstrap identity; production must configure onboarding separately.
BOVINA_BOOTSTRAP_ENABLED=true
BOVINA_BOOTSTRAP_ISSUER=http://localhost:8090/default
BOVINA_BOOTSTRAP_SUBJECT=dev-operator
# Exact frontend origins; no wildcard or browser credentials.
BOVINA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Host ports for the local PostgreSQL and API containers.
POSTGRES_PORT=5432
API_PORT=8080
# Enables local Swagger only; never use this profile for production.
BOVINA_PROFILE=dev
